# Copy to .env (never commit .env). Everything here is read by app/config.py.
TELEGRAM_BOT_TOKEN=put-token-from-BotFather-here
# Set automatically by `python -m scripts.run_all` (cloudflared tunnel). Only set it yourself when running `python -m app.bot` alone.
WEBAPP_URL=
SHOR_DEMO=0
SHOR_DB=shor_radar.db
# Optional: enables the "Ask AI" box and typed questions in the bot chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
